{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "coverage/**",
    "dist/**",
    ".pnpm-store/**",
    "test-results/**",
    "playwright-report/**",
  ],
}
